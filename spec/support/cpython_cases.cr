require "spec"
require "json"
require "../../argparse"

# Support code for the CPython derived conformance suite.
#
# `spec/fixtures/cpython_test_argparse.json` is generated by
# `spec/support/extract_python_cases.py` from CPython's `Lib/test/test_argparse.py`.
# Each record describes a parser (its keyword arguments), the arguments added to
# it, the argv lists that must be accepted together with the namespace CPython
# produces, and the argv lists that must be rejected.
module CpythonCases
  FIXTURE      = File.join(__DIR__, "..", "fixtures", "cpython_test_argparse.json")
  HELP_FIXTURE = File.join(__DIR__, "..", "fixtures", "cpython_help_cases.json")

  @@cases : Array(Case)? = nil
  @@help_cases : Array(HelpCase)? = nil

  # Decodes a fixture value into the value types the parser produces.
  def self.decode_value(value : JSON::Any) : Argparse::Value
    case raw = value.raw
    when Nil    then nil
    when Bool   then raw
    when String then raw
    when Int    then raw.to_i64
    when Float  then raw
    when Array(JSON::Any)
      result = Array(Argparse::Value).new
      raw.each { |item| result << decode_value(item) }
      result
    else
      raise "unsupported fixture value: #{raw.inspect}"
    end
  end

  def self.decode_spec(value : JSON::Any?) : Argparse::Spec
    return Argparse::UNSET if value.nil?
    return Argparse::SUPPRESS if value.raw.is_a?(Hash) && value.as_h.has_key?("__suppress__")
    decode_value(value)
  end

  # One declarative test case lifted from CPython's test suite.
  class Case
    getter name : String
    getter documentation : String
    getter parser_options : Hash(String, JSON::Any)
    getter argument_signatures : Array(Hash(String, JSON::Any))
    getter failures : Array(Array(String))
    getter successes : Array(Tuple(Array(String), Hash(String, Argparse::Value)))

    def initialize(@name : String, @documentation : String,
                   @parser_options : Hash(String, JSON::Any),
                   @argument_signatures : Array(Hash(String, JSON::Any)),
                   @failures : Array(Array(String)),
                   @successes : Array(Tuple(Array(String), Hash(String, Argparse::Value))))
    end

    # Builds the parser described by the case and adds all of its arguments.
    def build_parser : Argparse::ArgumentParser
      options = @parser_options.dup
      options["prog"] = JSON::Any.new("prog") unless options.has_key?("prog")
      CpythonCases.build_parser(options, @argument_signatures)
    end
  end

  # Builds a parser from a fixture definition.
  def self.build_parser(parser_options : Hash(String, JSON::Any),
                        signatures : Array(Hash(String, JSON::Any)),
                        width : Int32 = 78) : Argparse::ArgumentParser
    parser = Argparse::ArgumentParser.new(
      prog: parser_options["prog"]?.try(&.as_s?) || "prog",
      exit_on_error: false,
      usage: decode_usage(parser_options["usage"]?),
      description: parser_options["description"]?.try(&.as_s?),
      epilog: parser_options["epilog"]?.try(&.as_s?),
      add_help: bool_option(parser_options, "add_help", true),
      allow_abbrev: bool_option(parser_options, "allow_abbrev", true),
      prefix_chars: parser_options["prefix_chars"]?.try(&.as_s?) || "-",
      argument_default: decode_spec(parser_options["argument_default"]?),
      width: width
    )
    signatures.each do |signature|
      parser.add_argument(signature["args"].as_a.map(&.as_s), **keyword_arguments(signature))
    end
    parser
  end

  def self.bool_option(options : Hash(String, JSON::Any), key : String, fallback : Bool) : Bool
    value = options[key]?.try(&.as_bool?)
    value.nil? ? fallback : value
  end

  def self.decode_usage(value : JSON::Any?) : String | Argparse::Suppress | Nil
    return nil if value.nil?
    return Argparse::SUPPRESS if value.raw.is_a?(Hash)
    value.as_s?
  end

  def self.decode_help(value : JSON::Any?) : String | Argparse::Suppress | Nil
    return nil if value.nil?
    return Argparse::SUPPRESS if value.raw.is_a?(Hash)
    value.as_s?
  end

  def self.keyword_arguments(signature : Hash(String, JSON::Any)) : NamedTuple
    hash = signature["kwargs"].as_h
    {
      action:   hash["action"]?.try(&.as_s?),
      nargs:    decode_nargs(hash["nargs"]?),
      const:    decode_spec(hash["const"]?),
      default:  decode_spec(hash["default"]?),
      type:     hash["type"]?.try(&.as_s?),
      choices:  decode_choices(hash["choices"]?),
      required: hash["required"]?.try(&.as_bool?),
      help:     decode_help(hash["help"]?),
      metavar:  hash["metavar"]?.try(&.as_s?),
      dest:     hash["dest"]?.try(&.as_s?),
      version:  hash["version"]?.try(&.as_s?),
    }
  end

  def self.decode_nargs(value : JSON::Any?) : Int32 | String | Nil
    return nil if value.nil?
    case raw = value.raw
    when Int    then raw.to_i
    when String then raw
    else             nil
    end
  end

  def self.decode_choices(value : JSON::Any?) : Array(Argparse::Value)?
    return nil if value.nil?
    result = Array(Argparse::Value).new
    value.as_a.each { |item| result << decode_value(item) }
    result
  end

  # One HelpTestCase subclass: a parser definition plus the usage and help
  # text that CPython produces for it.
  class HelpCase
    getter name : String
    getter documentation : String
    getter parser_options : Hash(String, JSON::Any)
    getter argument_signatures : Array(Hash(String, JSON::Any))
    getter width : Int32
    getter usage : String
    getter help_text : String

    def initialize(@name : String, @documentation : String,
                   @parser_options : Hash(String, JSON::Any),
                   @argument_signatures : Array(Hash(String, JSON::Any)),
                   @width : Int32, @usage : String, @help_text : String)
    end

    def build_parser : Argparse::ArgumentParser
      CpythonCases.build_parser(@parser_options, @argument_signatures, @width)
    end
  end

  def self.help_cases : Array(HelpCase)
    @@help_cases ||= load_help_cases
  end

  def self.load_help_cases : Array(HelpCase)
    document = JSON.parse(File.read(HELP_FIXTURE))
    result = Array(HelpCase).new
    document["cases"].as_a.each do |entry|
      next if entry["skip"]?.try(&.as_s?)
      signatures = Array(Hash(String, JSON::Any)).new
      entry["arguments"].as_a.each { |signature| signatures << signature.as_h }
      result << HelpCase.new(
        entry["name"].as_s,
        entry["documentation"]?.try(&.as_s?) || "",
        entry["parser"].as_h,
        signatures,
        entry["width"].as_i,
        entry["usage"].as_s,
        entry["help"].as_s
      )
    end
    result
  end

  def self.cases : Array(Case)
    @@cases ||= load_cases
  end

  def self.load_cases : Array(Case)
    document = JSON.parse(File.read(FIXTURE))
    result = Array(Case).new
    document["cases"].as_a.each do |entry|
      next if entry["skip"]?.try(&.as_s?)
      successes = Array(Tuple(Array(String), Hash(String, Argparse::Value))).new
      entry["successes"].as_a.each do |success|
        argv = Array(String).new
        success["argv"].as_a.each { |item| argv << item.as_s }
        namespace = Hash(String, Argparse::Value).new
        success["namespace"].as_h.each { |key, value| namespace[key] = decode_value(value) }
        successes << {argv, namespace}
      end
      failures = Array(Array(String)).new
      entry["failures"].as_a.each do |failure|
        argv = Array(String).new
        failure.as_a.each { |item| argv << item.as_s }
        failures << argv
      end
      signatures = Array(Hash(String, JSON::Any)).new
      entry["arguments"].as_a.each { |signature| signatures << signature.as_h }
      result << Case.new(
        entry["name"].as_s,
        entry["documentation"]?.try(&.as_s?) || "",
        entry["parser"].as_h,
        signatures,
        failures,
        successes
      )
    end
    result
  end
end
